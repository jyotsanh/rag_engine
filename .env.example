# Copy to `.env` and fill in. Fields without a default in Settings are required.

# --- Server ---
PROD_HOST=0.0.0.0
PROD_PORT=8000
DEV_HOST=localhost
DEV_PORT=8000

PROJECT_NAME=RAG Engine
API_V1_STR=/api/v1

# --- CORS ---
# BACKEND_CORS_ORIGINS is a list; set via .env only if you need to override.
ALLOW_CREDENTIALS=False

# --- Database (raw document warehouse) ---
# Active backend — resolved by DatabaseDispatcher. One of: mongodb, postgres.
ACTIVE_DATABASE=mongodb

# --- MongoDB ---
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=rag_engine
# Full URI overrides HOST/PORT if set (e.g. mongodb://user:pass@host:27017)
# MONGO_URI=

# ---------------------------------------------------------------------------
# Reserved for later phases — uncomment as each lands.
#
# Phase 8 — async jobs (Celery + Redis)
# REDIS_HOST=localhost
# REDIS_PORT=6379
#
# Phase 9 — retrieval & generation (REQUIRED once enabled)
# ANTHROPIC_API_KEY=
# VOYAGE_API_KEY=
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# ---------------------------------------------------------------------------
