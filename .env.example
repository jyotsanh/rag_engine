# Copy to `.env` and fill in. Fields marked REQUIRED have no default: startup fails without them.

# --- app ---
# dev | test | prod
ENVIRONMENT=dev
PROJECT_NAME=RAG Engine
API_V1_STR=/api/v1
LOG_LEVEL=INFO
LOG_JSON=true
# per-dependency timeout for GET /api/v1/health/ready
READINESS_CHECK_TIMEOUT_SECONDS=2
DEV_HOST=127.0.0.1
DEV_PORT=8000
PROD_HOST=0.0.0.0
PROD_PORT=8000
# JSON list, e.g. ["https://dashboard.example.com"]
BACKEND_CORS_ORIGINS=[]
ALLOW_CREDENTIALS=false

# --- security ---
# REQUIRED, >= 32 chars. Master key for /admin/* (generate: python -c "import secrets;print(secrets.token_urlsafe(48))")
ADMIN_API_KEY=
# REQUIRED, >= 32 chars. Pepper for tenant API key hashes. To rotate: move the old value into
# API_KEY_PEPPER_PREVIOUS, set a new one; keys re-hash on next use.
API_KEY_PEPPER=
# JSON list of retired peppers still accepted while rotating (each >= 32 chars), e.g. ["old..."]
API_KEY_PEPPER_PREVIOUS=[]
SSRF_ALLOWED_PORTS=[80, 443]
# tests/local fixture sites only; rejected when ENVIRONMENT=prod
SSRF_ALLOW_PRIVATE_NETWORKS=false

# --- mongodb ---
# HOST/PORT are what the app connects to; docker-compose.yml publishes Mongo on this host port
MONGO_HOST=localhost
MONGO_PORT=27020
MONGO_DB=rag_engine
# REQUIRED by docker-compose.yml (root user it creates); the app uses them to connect
MONGO_USER=rag
MONGO_PASSWORD=
# Full URI overrides HOST/PORT/USER/PASSWORD when set
# MONGO_URI=
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_MAX_POOL_SIZE=100

# --- redis ---
REDIS_HOST=localhost
REDIS_PORT=6380
# REQUIRED by docker-compose.yml (redis --requirepass)
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CELERY_BROKER_DB=1
REDIS_CELERY_RESULT_DB=2
# lowercase [a-z0-9_-], prefixes every application key
REDIS_KEY_PREFIX=rag
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5
REDIS_MAX_CONNECTIONS=100

# --- celery ---
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=10800
CELERY_TASK_TIME_LIMIT_SECONDS=11100
CELERY_WORKER_CONCURRENCY=2

# --- vector store ---
ACTIVE_VECTOR_STORE=qdrant
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_PREFER_GRPC=true
QDRANT_HTTPS=false
# REQUIRED by docker-compose.yml (Qdrant service API key)
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=30

# --- embeddings ---
ACTIVE_EMBEDDING_PROVIDER=openai
# REQUIRED
OPENAI_API_KEY=
# OPENAI_BASE_URL=
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=6
OPENAI_MAX_CONCURRENT_REQUESTS=4
# text-embedding-3-small | text-embedding-3-large. Tenant default; each KB locks its model at creation
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# --- reranker ---
ACTIVE_RERANKER=cross_encoder

# --- tenant quota defaults (admins override per tenant) ---
TENANT_DEFAULT_MAX_KNOWLEDGE_BASES=20
TENANT_DEFAULT_MAX_CONCURRENT_JOBS=2
# must be <= CRAWL_HARD_MAX_PAGES
TENANT_DEFAULT_MAX_PAGES_PER_JOB=2000
TENANT_DEFAULT_API_RATE_LIMIT_PER_MINUTE=120
# cap on usable API keys per tenant
TENANT_MAX_ACTIVE_API_KEYS=10

# --- crawler ---
CRAWL_USER_AGENT=RagEngineBot/0.1 (+https://github.com/jyotsanh/rag_engine)
CRAWL_DEFAULT_MAX_PAGES=500
CRAWL_HARD_MAX_PAGES=10000
CRAWL_DEFAULT_MAX_DEPTH=10
CRAWL_HARD_MAX_DEPTH=50
CRAWL_MAX_JOB_SECONDS=7200
CRAWL_MAX_PAGE_BYTES=20971520
CRAWL_MAX_TOTAL_BYTES=2147483648
CRAWL_CONCURRENCY=8
# per-host politeness, shared by all workers (<= 100)
CRAWL_PER_DOMAIN_RPS=2.0
# requests allowed back-to-back before spacing applies (1 = always spaced)
CRAWL_PER_DOMAIN_BURST=1
# robots.txt Crawl-delay is honoured up to this many seconds
CRAWL_MAX_CRAWL_DELAY_SECONDS=30
# wall-clock cap per extracted document
EXTRACTION_TIMEOUT_SECONDS=120
CRAWL_CONNECT_TIMEOUT_SECONDS=10
CRAWL_READ_TIMEOUT_SECONDS=30
# total time per fetch incl. redirects (>= read timeout)
CRAWL_FETCH_TIMEOUT_SECONDS=60
CRAWL_MAX_REDIRECTS=5
# retries after the first attempt (transient failures only: timeouts, 5xx, 429, network)
CRAWL_MAX_RETRIES=3
# exponential backoff with jitter; must be base <= max
CRAWL_RETRY_BASE_DELAY_SECONDS=1
CRAWL_RETRY_MAX_DELAY_SECONDS=30
# a longer Retry-After than this fails the page instead of waiting
CRAWL_RETRY_AFTER_MAX_SECONDS=120
# re-render HTML in headless Chromium: auto | always | never
CRAWL_JS_RENDERING=auto
CRAWL_RENDER_TIMEOUT_SECONDS=30
# after load: network-idle wait cap; auto-scroll time cap and steps (0 = no scrolling)
CRAWL_RENDER_NETWORKIDLE_SECONDS=5
CRAWL_RENDER_SCROLL_SECONDS=5
CRAWL_RENDER_SCROLL_MAX_STEPS=20
# headless Chromium: open pages per worker process, blocked request types, relaunch cadence
CRAWL_BROWSER_MAX_PAGES=4
CRAWL_BROWSER_BLOCKED_RESOURCES=["image","font","media"]
CRAWL_BROWSER_RECYCLE_AFTER_CONTEXTS=100
CRAWL_BROWSER_HEADLESS=true
# skip rel=nofollow links (and all links on meta/X-Robots-Tag nofollow pages)
CRAWL_RESPECT_NOFOLLOW=true
# link candidates considered per page (<= 100000)
CRAWL_MAX_LINKS_PER_PAGE=5000
# sitemaps: bytes per file (compressed and inflated), files per discovery, index nesting
SITEMAP_MAX_BYTES=52428800
SITEMAP_MAX_FILES=50
SITEMAP_MAX_DEPTH=3
# good robots.txt copies (<= 86400, RFC 9309)
ROBOTS_CACHE_TTL_SECONDS=3600
# unreachable robots.txt (5xx/network → disallow all) is re-checked sooner; <= the TTL above
ROBOTS_UNREACHABLE_CACHE_TTL_SECONDS=300
# when unreachable, reuse the last good copy if it is at most this old (7 days)
ROBOTS_STALE_MAX_SECONDS=604800
