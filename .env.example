# Copy to `.env` and fill in. Fields marked REQUIRED have no default: startup fails without them.

# --- app ---
# dev | test | prod
ENVIRONMENT=dev
PROJECT_NAME=RAG Engine
API_V1_STR=/api/v1
LOG_LEVEL=INFO
LOG_JSON=true
DEV_HOST=127.0.0.1
DEV_PORT=8000
PROD_HOST=0.0.0.0
PROD_PORT=8000
# JSON list, e.g. ["https://dashboard.example.com"]
BACKEND_CORS_ORIGINS=[]
ALLOW_CREDENTIALS=false

# --- security ---
# REQUIRED, >= 32 chars. Master key for /admin/* (generate: python -c "import secrets;print(secrets.token_urlsafe(48))")
ADMIN_API_KEY=
# REQUIRED, >= 32 chars. Pepper for tenant API key hashes. Changing it invalidates every issued key.
API_KEY_PEPPER=
SSRF_ALLOWED_PORTS=[80, 443]
# tests/local fixture sites only; rejected when ENVIRONMENT=prod
SSRF_ALLOW_PRIVATE_NETWORKS=false

# --- mongodb ---
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=rag_engine
# MONGO_USER=
# MONGO_PASSWORD=
# Full URI overrides HOST/PORT/USER/PASSWORD when set
# MONGO_URI=

# --- redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=0
REDIS_CELERY_BROKER_DB=1
REDIS_CELERY_RESULT_DB=2

# --- celery ---
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=10800
CELERY_TASK_TIME_LIMIT_SECONDS=11100
CELERY_WORKER_CONCURRENCY=2

# --- vector store ---
ACTIVE_VECTOR_STORE=qdrant
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_PREFER_GRPC=true
QDRANT_HTTPS=false
# QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=30

# --- embeddings ---
ACTIVE_EMBEDDING_PROVIDER=openai
# REQUIRED
OPENAI_API_KEY=
# OPENAI_BASE_URL=
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=6
OPENAI_MAX_CONCURRENT_REQUESTS=4
# text-embedding-3-small | text-embedding-3-large. Tenant default; each KB locks its model at creation
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# --- reranker ---
ACTIVE_RERANKER=cross_encoder

# --- crawler ---
CRAWL_USER_AGENT=RagEngineBot/0.1 (+https://github.com/jyotsanh/rag_engine)
CRAWL_DEFAULT_MAX_PAGES=500
CRAWL_HARD_MAX_PAGES=10000
CRAWL_DEFAULT_MAX_DEPTH=10
CRAWL_HARD_MAX_DEPTH=50
CRAWL_MAX_JOB_SECONDS=7200
CRAWL_MAX_PAGE_BYTES=20971520
CRAWL_MAX_TOTAL_BYTES=2147483648
CRAWL_CONCURRENCY=8
CRAWL_PER_DOMAIN_RPS=2.0
CRAWL_CONNECT_TIMEOUT_SECONDS=10
CRAWL_READ_TIMEOUT_SECONDS=30
CRAWL_MAX_REDIRECTS=5
CRAWL_MAX_RETRIES=3
CRAWL_RENDER_TIMEOUT_SECONDS=30
ROBOTS_CACHE_TTL_SECONDS=3600
